{
  "name": "@layover/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next dev -p 3000",
    "build": "next build",
    "start": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next start -p 3000",
    "test": "echo \"web: unit tests live in Playwright (pnpm --filter @layover/web e2e)\"",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@layover/shared": "workspace:*",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
