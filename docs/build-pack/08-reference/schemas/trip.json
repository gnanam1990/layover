{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trip.json",
  "title": "trip",
  "type": "object",
  "required": [
    "id",
    "travelerName",
    "flights",
    "hotelBookings",
    "settings",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "travelerName": {
      "type": "string"
    },
    "flights": {
      "type": "array",
      "items": {
        "$ref": "flight.json"
      }
    },
    "hotelBookings": {
      "type": "array",
      "items": {
        "$ref": "hotel-booking.json"
      }
    },
    "settings": {
      "$ref": "trip-settings.json"
    },
    "status": {
      "enum": [
        "draft",
        "protected",
        "completed"
      ]
    }
  }
}
