{
  "name": "layover",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n mocks,core,web -c magenta,cyan,green \"pnpm --filter @layover/mocks dev\" \"pnpm --filter @layover/core dev\" \"pnpm --filter @layover/web dev\"",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "demo:act1": "pnpm --filter @layover/core demo:act1",
    "demo:act2": "pnpm --filter @layover/core demo:act2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
